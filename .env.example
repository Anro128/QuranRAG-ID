DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EMBED_MODEL=intfloat/multilingual-e5-base
# true bila aplikasi disajikan lewat HTTPS
COOKIE_SECURE=false
# Encoder query: auto (ONNX bila data/models/e5-base-int8 ada) | onnx | torch
EMBED_BACKEND=auto
# Jumlah thread ONNX Runtime. 0 = otomatis: jumlah core yang tersedia untuk proses, maksimal 4.
ORT_THREADS=0
